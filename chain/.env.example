# Copy this file to ".env" (in this same folder) and fill it in.
# .env is listed in .gitignore, so it never goes to GitHub. Keep it that way.
# Never paste these values in a chat, a screenshot or a commit.

# ── Hedera ────────────────────────────────────────────────────────────────

# The "HEX Encoded Private Key" of a TESTNET account, from the Hedera Portal
# dashboard (portal.hedera.com). Never put a key that controls real money here.
# This account deploys the contract, owns it, approves the companies, and pays
# for the agent's public log.
AGENT_PRIVATE_KEY=

# The same account's "Account ID" from the dashboard. It looks like 0.0.1234567.
# Optional: left empty, the agent looks it up from its address.
AGENT_ACCOUNT_ID=

HEDERA_RPC_URL=https://testnet.hashio.io/api

# ── Language model ────────────────────────────────────────────────────────

# Your Groq API key, from console.groq.com (API Keys).
GROQ_API_KEY=

# The model the agent asks. If your key is not offered this one, the agent
# picks another it can use and says which.
GROQ_MODEL=openai/gpt-oss-120b

# ── Agent ─────────────────────────────────────────────────────────────────

# The pages open at http://localhost:<PORT>
PORT=3000

# Optional. The address of your published Lovable site, for example
# https://my-site.lovable.app. The agent only uses it to fetch the pictures
# the pages show. Without it, it tries the project's preview address.
LOVABLE_SITE=
