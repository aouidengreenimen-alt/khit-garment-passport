        { "do": "make", "by": "mill2", "as": "fabricB", "from": [["yarnB", 500]], "step": "weaving", "kg": 480, "product": "Indigo denim, 11 oz", "reference": "DW-3302" },
        { "do": "ship", "by": "mill2", "lot": "fabricB", "to": "factory", "as": "fabricB@factory", "kg": 480, "reference": "DN-7741" },
        { "do": "make", "by": "factory", "as": "jeansB", "from": [["fabricB@factory", 480]], "step": "sewing", "kg": 425, "product": "Women's jeans, model Sidi Bou", "reference": "J-512", "pieces": 700 },
        { "do": "make", "by": "factory", "as": "washedB", "from": [["jeansB", 425]], "step": "finishing", "kg": 420, "product": "Women's jeans, light wash", "reference": "J-512-W", "pieces": 700 },
